# Order Flow — Environment Variables
#
# Copy this file to .env and fill in your real values.
# The .env file is git-ignored and must never be committed.
#
# Get these values from:
#   Firebase Console → Your Project → Project Settings → General
#   → Your apps → Web app → SDK setup and configuration
#
# Firebase API keys are publishable (not secret). Security is enforced
# by Firestore Security Rules and Storage Security Rules, not key secrecy.
# Never put a Firebase Admin SDK service account key in frontend code.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
